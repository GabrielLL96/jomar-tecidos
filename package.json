{
  "name": "jomartecidos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "build": "npm run format && npm run type-check && npm run lint && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "dotenv -- sh -c \"npx supabase gen types typescript --project-id $VITE_SUPABASE_PROJECT_ID --schema public\" > src/lib/database.types.ts",
    "db:mig:new": "supabase migration new",
    "db:diff": "dotenv -- sh -c 'supabase db diff -f $(date +\"%Y%m%d_%H%M%S\")'",
    "db:push": "supabase db push",
    "db:studio": "supabase studio",
    "sb:login": "dotenv -- sh -c 'supabase login --token $SUPABASE_ACCESS_TOKEN'",
    "sb:link": "supabase link --project-ref",
    "fn:deploy": "supabase functions deploy meta-catalog-feed --no-verify-jwt",
    "fn:deploy:melhor-envio-oauth-exchange": "supabase functions deploy melhor-envio-oauth-exchange",
    "fn:deploy:melhor-envio-shipping-calculate": "supabase functions deploy melhor-envio-shipping-calculate",
    "fn:deploy:melhor-envio-webhook": "supabase functions deploy melhor-envio-webhook --no-verify-jwt",
    "fn:deploy:admin-create-user": "supabase functions deploy admin-create-user",
    "fn:deploy:all": "supabase functions deploy"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
